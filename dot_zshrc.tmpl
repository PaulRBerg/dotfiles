# Base directory for custom shell modules
USER_DIR="${USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/prb}"

# Core environment and PATH must load before the rest of the shell modules.
[[ -r "$USER_DIR/env_core.sh" ]] && source "$USER_DIR/env_core.sh"
[[ -r "$USER_DIR/path.sh" ]] && source "$USER_DIR/path.sh"

# Load tracked core shell modules.
core_dotfiles=(
  "$USER_DIR/agents.sh"
  "$USER_DIR/aliases.sh"
  "$USER_DIR/web3.sh"
  "$USER_DIR/functions.sh"
  "$USER_DIR/gh.sh"
  "$USER_DIR/env_session.sh"
  "$USER_DIR/shims.sh"
)
for file in "${core_dotfiles[@]}"; do
  [[ -r "$file" ]] && source "$file"
done
unset file core_dotfiles

# Uncomment the following line to use case-sensitive completion.
export CASE_SENSITIVE="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see "man strftime" for details.
export HIST_STAMPS="yyyy-mm-dd"

# Persist the full in-memory history: Oh My Zsh floors SAVEHIST at 10k while
# HISTSIZE is 50k, and zsh-autosuggestions feeds on file-backed history.
# shellcheck disable=SC2034
SAVEHIST=50000

# Skip url-quote-magic and bracketed-paste-magic: they slow down and can
# mangle large pastes with zsh-autosuggestions. URLs with ?& need quoting.
# shellcheck disable=SC2034
DISABLE_MAGIC_FUNCTIONS="true"

# Load custom functions
# shellcheck disable=SC2206
typeset -gU fpath FPATH
fpath=("$USER_DIR/zfunc" "$HOME/.zfunc" $fpath)

# Keep compdump stable and skip compaudit for faster startup
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/compdump-${ZSH_VERSION}"
mkdir -p "${ZSH_COMPDUMP:h}"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Add wisely, as too many plugins slow down shell startup.
# shellcheck disable=SC2034
plugins=(
  colored-man-pages
  extract
  fnm
  fzf # Ctrl-T files, Alt-C cd, **<Tab> completion; atuin re-binds Ctrl-R later
  gitfast
  magic-enter
  sudo
  fzf-tab                 # custom: https://github.com/Aloxaf/fzf-tab
  zsh-autosuggestions     # custom: https://github.com/zsh-users/zsh-autosuggestions
  zsh-syntax-highlighting # custom, must be the last one: https://github.com/zsh-users/zsh-syntax-highlighting
)

# Drop fzf in headless shells (no controlling tty, e.g. CI or tool-spawned
# `zsh -ic`): zle can't be enabled there, so fzf's option save/restore
# prints "can't change option: zle" on load.
# shellcheck disable=SC2206
{ : </dev/tty; } 2>/dev/null || plugins=(${plugins[@]/#%fzf/})

# magic-enter: command to run when pressing Enter on an empty buffer
# shellcheck disable=SC2034
MAGIC_ENTER_GIT_COMMAND='git status -sb'
# shellcheck disable=SC2034
MAGIC_ENTER_OTHER_COMMAND='l'

# Suggest from history first, falling back to the completion engine
# shellcheck disable=SC2034
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# No theme - starship handles the prompt
export ZSH_THEME=""

# Update automatically without asking
zstyle ":omz:update" mode auto # update automatically without asking

# Skip aliases defined in Oh My Zsh lib files (ls, l, .., etc.)
zstyle ":omz:lib:*" aliases no

# fnm plugin: eval `fnm env --use-on-cd` (auto-switch Node on cd) + completions
zstyle ":omz:plugins:fnm" autostart yes

# fzf-tab: use zsh's completion data, but render the selector through fzf.
zstyle ":completion:*:descriptions" format "[%d]"
[[ -n "${LS_COLORS:-}" ]] && eval 'zstyle ":completion:*" list-colors ${(s.:.)LS_COLORS}'
zstyle ":completion:*" menu no
zstyle ":completion:*:git-checkout:*" sort false
zstyle ":completion:*:git-switch:*" sort false
zstyle ":fzf-tab:*" switch-group "<" ">"
zstyle ":fzf-tab:complete:cd:*" fzf-preview "eza -1 --color=always --icons=auto --group-directories-first -- \$realpath"
zstyle ":fzf-tab:complete:git-checkout:argument-rest:*" fzf-preview "git log --oneline --graph --color=always -20 \$word --"
zstyle ":fzf-tab:complete:git-switch:argument-rest:*" fzf-preview "git log --oneline --graph --color=always -20 \$word --"

# Don't auto-set the terminal title (defaults to user@hostname:cwd); let the terminal manage it
DISABLE_AUTO_TITLE="true"

# Clear any stale window title on return to the prompt. Some tools set it via OSC 0
# (window + tab) and never reset on exit, so the title lingers under claude/codex.
# OSC 2 blanks only the window title; live app titles are untouched since precmd
# fires only once control is back at the shell.
if [[ -o interactive ]]; then
  _prb_reset_window_title() { print -n '\e]2;\a'; }
  precmd_functions+=(_prb_reset_window_title)
fi

# Skip compaudit security check on non-login shells (saves ~15-20ms per shell startup)
if [[ -o login ]]; then
  zstyle ":omz:lib:compfix" skip no
else
  zstyle ":omz:lib:compfix" skip yes
fi

# Load oh-my-zsh
source "$ZSH/oh-my-zsh.sh"

# Enable recursive globbing with **
setopt GLOB_STAR_SHORT

# zoxide - smart directory jumping (must be after oh-my-zsh for compinit)
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

{{- if eq .chezmoi.os "darwin" }}
# Atuin - enhanced shell history with sync (must be after oh-my-zsh)
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh)"
fi
{{- end }}

# Television widgets: Ctrl-X Ctrl-F file, Ctrl-X Ctrl-D directory,
# Ctrl-X Ctrl-R repo, Ctrl-X Ctrl-B branch, Ctrl-X Ctrl-J just recipe.
if command -v tv &>/dev/null && [[ -o interactive ]]; then
  zle -N prb-tv-file-widget
  zle -N prb-tv-dir-widget
  zle -N prb-tv-repo-widget
  zle -N prb-tv-branch-widget
  zle -N prb-tv-just-widget

  bindkey "^X^F" prb-tv-file-widget
  bindkey "^X^D" prb-tv-dir-widget
  bindkey "^X^R" prb-tv-repo-widget
  bindkey "^X^B" prb-tv-branch-widget
  bindkey "^X^J" prb-tv-just-widget
fi

# bun completions
[[ -s "${BUN_INSTALL:-$HOME/.local/share/bun}/_bun" ]] && source "${BUN_INSTALL:-$HOME/.local/share/bun}/_bun"

# Google Cloud SDK completions
{{- if eq .chezmoi.os "darwin" }}
[[ -s "$HOME/.local/share/google-cloud-sdk/completion.zsh.inc" ]] && source "$HOME/.local/share/google-cloud-sdk/completion.zsh.inc"
{{- end }}

# Starship prompt (must be last)
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"

  # Transient prompt - collapse previous prompts to single line
  zle-line-init() {
    emulate -L zsh
    [[ $CONTEXT == start ]] || return 0

    while true; do
      zle .recursive-edit
      local -i ret=$?
      [[ $ret == 0 && $KEYS == $'\4' ]] || break
      [[ -o ignore_eof ]] || exit 0
    done

    local saved_prompt=$PROMPT
    local saved_rprompt=$RPROMPT
    PROMPT='❯ '
    RPROMPT=''
    zle .reset-prompt
    PROMPT=$saved_prompt
    RPROMPT=$saved_rprompt

    if ((ret)); then
      zle .send-break
    else
      zle .accept-line
    fi
    return ret
  }
  zle -N zle-line-init
fi

# Login-shell guard: `zsh -i <script>` (e.g. just recipes) fires preexec without
# precmd, and iterm2_preexec reads ITERM2_PRECMD_PS1, which breaks under `set -u`.
if [[ "$TERM_PROGRAM" == "iTerm.app" && -o login ]]; then
  export ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX="${ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX:-1}"
  iterm2_print_user_vars() {
    local repo branch
    repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$repo" ]]; then
      branch=$(git -C "$repo" branch --show-current 2>/dev/null || true)
    else
      branch=""
    fi
    iterm2_set_user_var prbRepo "$repo"
    iterm2_set_user_var prbBranch "$branch"
  }
  test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

  # Starship rewrites PS1 after iTerm2's shell integration decorates it, so the
  # integration's own OSC-133 prompt mark never survives and ⌘⇧↑/↓ (Previous/
  # Next Mark) have nothing to jump to. Emit an explicit iTerm2 mark each prompt
  # (independent of PS1) so shell prompt-to-prompt navigation works.
  autoload -Uz add-zsh-hook
  _prb_iterm2_mark() { printf '\033]1337;SetMark\007'; }
  add-zsh-hook precmd _prb_iterm2_mark
fi
