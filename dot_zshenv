# XDG Base Directory Specification (set early for PATH setup in .zshrc)
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ripgrep does not auto-load config files; point it at the XDG config.
export RIPGREP_CONFIG_PATH="${RIPGREP_CONFIG_PATH:-$XDG_CONFIG_HOME/ripgrep/config}"

# Keep user-managed shims ahead of system binaries for all zsh invocations,
# including non-interactive shells that do not read ~/.zshrc.
if [[ -d "$HOME/.local/bin" ]]; then
  path=("$HOME/.local/bin" ${path:#"$HOME/.local/bin"})
  export PATH
fi

# Coding agents (Claude Code, Codex) run commands through zsh but write bash by
# habit. Make unmatched globs, `echo =====`, and alias-named functions behave as
# in bash for those shells only. Claude Code's shell snapshot replays only
# non-default options, so these survive it.
if [[ -n "${CLAUDECODE:-}" || -n "${CODEX_THREAD_ID:-}" ]]; then
  setopt no_nomatch no_equals no_aliases
fi
