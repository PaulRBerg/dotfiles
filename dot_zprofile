# macOS path_helper runs before this file in login shells and can move
# /usr/bin ahead of user shims. Put user-managed bins back in front.
_path_prepend_if_dir() {
  [[ -d "$1" ]] && path=("$1" ${path:#"$1"})
}

if [[ "$OSTYPE" == darwin* ]]; then
  homebrew_prefix="${HOMEBREW_PREFIX:-}"
  if [[ -z "$homebrew_prefix" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
      homebrew_prefix="/opt/homebrew"
    elif [[ -x /usr/local/bin/brew ]]; then
      homebrew_prefix="/usr/local"
    fi
  fi
  if [[ -n "$homebrew_prefix" ]]; then
    _path_prepend_if_dir "$homebrew_prefix/sbin"
    _path_prepend_if_dir "$homebrew_prefix/bin"
  fi
  unset homebrew_prefix
fi

if [[ -d "$HOME/.local/bin" ]]; then
  _path_prepend_if_dir "$HOME/.local/bin"
fi

unset -f _path_prepend_if_dir
export PATH
