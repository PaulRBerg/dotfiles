#!/usr/bin/env bash
# Minimal bashrc - zsh is the primary shell
# This exists only as a fallback for bash interactive sessions

# Exit early if non-interactive
[[ $- != *i* ]] && return

PRB_CONFIG_DIR="${PRB_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/prb}"

# Source common dotfiles
[[ -r "$PRB_CONFIG_DIR/path.sh" ]] && source "$PRB_CONFIG_DIR/path.sh"
[[ -r "$PRB_CONFIG_DIR/aliases.sh" ]] && source "$PRB_CONFIG_DIR/aliases.sh"
[[ -r "$PRB_CONFIG_DIR/functions.sh" ]] && source "$PRB_CONFIG_DIR/functions.sh"
