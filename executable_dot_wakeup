#!/usr/bin/env bash
# Wakeup script for sleepwatcher
# Runs when Mac wakes from sleep

# Sleepwatcher runs with a minimal PATH; ensure Homebrew binaries are available
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# ------------------------------
# SSH key
# ------------------------------
SSH_KEY="$HOME/.ssh/github/key.pem"
if [[ -f "$SSH_KEY" ]] && ! /usr/bin/ssh-add -l 2>/dev/null | grep -q "$SSH_KEY"; then
  /usr/bin/ssh-add --apple-use-keychain "$SSH_KEY" 2>/dev/null
fi

# ------------------------------
# Pull repos
# ------------------------------
PULL_REPOS=(
  "$HOME/.effect"
  "$HOME/.claude"
  "$HOME/.agents"
  "$HOME/.local/share/chezmoi"
  "$HOME/projects/agent-skills"
)

for repo in "${PULL_REPOS[@]}"; do
  if [[ ! -d "$repo/.git" ]]; then
    continue
  fi
  if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
    echo "Skipping $repo (dirty worktree)"
    continue
  fi
  echo "Pulling $repo"
  git -C "$repo" pull --ff-only 2>&1 || true
done

# ------------------------------
# Merge Claude settings
# ------------------------------
CLAUDE_DIR="$HOME/.claude"
if [[ -d "$CLAUDE_DIR/.git" ]] && [[ -z "$(git -C "$CLAUDE_DIR" status --porcelain 2>/dev/null)" ]]; then
  echo "Merging Claude settings"
  (cd "$CLAUDE_DIR" && just merge-settings 2>&1) || true
fi

# ------------------------------
# Build Codex AGENTS.md
# ------------------------------
CODEX_DIR="$HOME/.codex"
if [[ -d "$CODEX_DIR/.git" ]] && [[ -z "$(git -C "$CODEX_DIR" status --porcelain 2>/dev/null)" ]]; then
  echo "Building Codex AGENTS.md"
  (cd "$CODEX_DIR" && just build 2>&1) || true
  git -C "$CODEX_DIR" add -A
  if [[ -n "$(git -C "$CODEX_DIR" status --porcelain 2>/dev/null)" ]]; then
    echo "Committing Codex changes"
    git -C "$CODEX_DIR" commit -m "Build AGENTS.md $(date -u +%Y-%m-%d@%H-%M-%S)" 2>&1 || true
  fi
  echo "Pushing Codex"
  git -C "$CODEX_DIR" push origin 2>&1 || true
fi

# ------------------------------
# Update package managers
# ------------------------------
# bun lives in its own install dir and npm comes from fnm; neither is on
# sleepwatcher's PATH
export PATH="$HOME/.local/share/bun/bin:$HOME/Library/Application Support/fnm/aliases/default/bin:$PATH"

if command -v bun >/dev/null; then
  echo "Updating bun"
  bun upgrade 2>&1 || true
  echo "Updating pnpm"
  bun add --global pnpm 2>&1 || true
fi

if command -v npm >/dev/null; then
  echo "Updating npm"
  npm install -g npm 2>&1 || true
fi

# ------------------------------
# Update uv and its tools
# ------------------------------
# Standalone install; not on sleepwatcher's PATH
UV="$HOME/.local/bin/uv"
if [[ -x "$UV" ]]; then
  echo "Updating uv"
  "$UV" self update 2>&1 || true
  echo "Updating uv tools"
  "$UV" tool upgrade --all 2>&1 || true
fi

# ------------------------------
# Commit and push dictionary
# ------------------------------
DICTIONARY_DIR="$HOME/work/dictionary"
if [[ -d "$DICTIONARY_DIR/.git" ]]; then
  cd "$DICTIONARY_DIR" || exit
  git add -A
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "Committing dictionary changes"
    git commit -m "Update words $(date -u +%Y-%m-%d@%H-%M-%S)" 2>&1 || true
  fi
  echo "Pushing dictionary"
  git push origin 2>&1 || true
fi
