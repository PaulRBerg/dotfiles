# Rendered by `chezmoi init` from .chezmoi.toml.tmpl.
# Edit the template in the chezmoi source dir, not ~/.config/chezmoi/chezmoi.toml.

[data.chezmoi]
{{- if eq .chezmoi.os "darwin" }}
  hostname = "personal"
{{- else }}
  hostname = "aws"
{{- end }}

[onepassword]
  mode = "account"
  # Skip chezmoi's own `op signin`; rely on the 1Password desktop-app CLI
  # integration (Touch ID). Enable it in 1Password -> Settings -> Developer.
  prompt = false
