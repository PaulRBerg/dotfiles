# Rendered by `chezmoi init` from .chezmoi.toml.tmpl.
# Edit the template in the chezmoi source dir, not ~/.config/chezmoi/chezmoi.toml.

[data.chezmoi]
{{- if eq .chezmoi.os "darwin" }}
  hostname = "personal"
{{- else }}
  hostname = "aws"
{{- end }}

[onepassword]
  mode = "service"
  # Requires OP_SERVICE_ACCOUNT_TOKEN. `chezmoi-service` loads it from macOS
  # Keychain before execing chezmoi.
