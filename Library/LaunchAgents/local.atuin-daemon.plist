<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.atuin-daemon</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>StandardIO</string>
		<string>System</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>source "$HOME/.config/prb/env_core.sh"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/atuin"
mkdir -p "$log_dir"
exec &gt;&gt;"$log_dir/daemon.log" 2&gt;&amp;1
source "$HOME/.config/prb/path.sh"
exec atuin daemon start --force</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
