min-release-age=7
# Packages exempt from the 7-day cooldown. Keep identical to minimumReleaseAgeExcludes
# in ~/.config/.bunfig.toml and minimumReleaseAgeExclude in ~/.config/pnpm/config.yaml;
# tests/release_age_excludes.bats enforces it.
min-release-age-exclude[]=@effect-atom/atom
min-release-age-exclude[]=@effect-atom/atom-react
min-release-age-exclude[]=@effect/cli
min-release-age-exclude[]=@effect/experimental
min-release-age-exclude[]=@effect/opentelemetry
min-release-age-exclude[]=@effect/platform
min-release-age-exclude[]=@effect/platform-browser
min-release-age-exclude[]=@effect/platform-bun
min-release-age-exclude[]=@effect/platform-node
min-release-age-exclude[]=@effect/platform-node-shared
min-release-age-exclude[]=@effect/rpc
min-release-age-exclude[]=@effect/vitest
min-release-age-exclude[]=@prb/crypto-registry
min-release-age-exclude[]=@prb/devkit
min-release-age-exclude[]=@prb/effect-evm
min-release-age-exclude[]=@prb/effect-evm-safe
min-release-age-exclude[]=@prb/effect-next
min-release-age-exclude[]=@prb/effect-solana
min-release-age-exclude[]=@prb/effect-xstate
min-release-age-exclude[]=@prb/math
min-release-age-exclude[]=@sablier/indexers
min-release-age-exclude[]=@sablier/price-data
min-release-age-exclude[]=@types/node
min-release-age-exclude[]=@typescript/native-preview
min-release-age-exclude[]=chrome-devtools-mcp
min-release-age-exclude[]=effect
min-release-age-exclude[]=react-grab
min-release-age-exclude[]=sablier
min-release-age-exclude[]=typescript

# Allow install (life-cycle) scripts only for these trusted packages during
# `npm install -g` / npx (npm 11+ allow-scripts policy). Each name is matched
# against the dependency's resolved identity. Unlisted packages still run their
# scripts but print a warning (advisory in npm 11.x; a future release will block
# them outright). Add a trusted global below to silence its postinstall nag.
allow-scripts[]=bun
