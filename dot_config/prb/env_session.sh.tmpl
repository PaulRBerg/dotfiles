#!/usr/bin/env bash

###############################################################################
# SESSION ENVIRONMENT                                                         #
###############################################################################

[[ -n "${TTY:-}" ]] && export GPG_TTY="$TTY" # https://stackoverflow.com/a/42265848/96656

export MANPAGER="sh -c 'col -bx | bat -plman --paging=always'" # Render man pages with bat instead of less.
export BAT_THEME="Visual Studio Dark+"                         # Matches delta's syntax-theme in gitconfig.
export LESS="-RFXi"

# vivid generates LS_COLORS from a theme; skip if not installed.
command -v vivid >/dev/null 2>&1 && export LS_COLORS="$(vivid generate one-dark)"

# Node
export NODE_REPL_HISTORY="${NODE_REPL_HISTORY:-$HOME/.node_history}" # Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY_SIZE="${NODE_REPL_HISTORY_SIZE:-32768}"     # Allow 32³ entries; the default is 1000.
export NODE_REPL_MODE="${NODE_REPL_MODE:-sloppy}"                    # Use sloppy mode by default, matching web browsers.

# Python
export PYTHONIOENCODING="${PYTHONIOENCODING:-UTF-8}"

###############################################################################
# API KEYS                                                                    #
###############################################################################

# Kept in a separate file so ~/.zshenv can export them for coding-agent shells.
PRB_ENV_KEYS="${XDG_CONFIG_HOME:-$HOME/.config}/prb/env_keys.sh"
[[ -r "$PRB_ENV_KEYS" ]] && source "$PRB_ENV_KEYS"
unset PRB_ENV_KEYS

###############################################################################
# LANGUAGES AND TOOLS                                                         #
###############################################################################

# Foundry
export FOUNDRY_DISABLE_NIGHTLY_WARNING="true"

# fzf
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git --exclude .DS_Store | sort'
export FZF_CTRL_T_COMMAND='fd --type f --hidden --exclude .git --exclude .DS_Store | sort'
export FZF_DEFAULT_COMMAND="$FZF_CTRL_T_COMMAND"
export FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border'
export FZF_CTRL_T_OPTS='--no-sort'
export FZF_ALT_C_OPTS='--no-sort'

# OpenSSL
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/opt/openssl" ]]; then
  export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/openssl/include"
  export LDFLAGS="-L$HOMEBREW_PREFIX/opt/openssl/lib"
fi

# Homebrew
export HOMEBREW_CLEANUP_MAX_AGE_DAYS="${HOMEBREW_CLEANUP_MAX_AGE_DAYS:-30}"
export HOMEBREW_NO_AUTO_UPDATE=1

# Editor (nvim for Ctrl+G in Claude Code and other tools)
export EDITOR="nvim"
export VISUAL="nvim"

# Xcode
# https://stackoverflow.com/q/51314888/3873510
if command -v xcrun >/dev/null; then
  xcode_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/xcrun"
  xcode_cache_file="$xcode_cache_dir/sdk-path"
  if [[ -r "$xcode_cache_file" ]]; then
    sdk_path=$(<"$xcode_cache_file")
  else
    mkdir -p "$xcode_cache_dir"
    sdk_path=$(xcrun --show-sdk-path)
    [[ -n "$sdk_path" ]] && printf '%s\n' "$sdk_path" >|"${xcode_cache_file}"
  fi
  export SDKROOT="$sdk_path"
fi
