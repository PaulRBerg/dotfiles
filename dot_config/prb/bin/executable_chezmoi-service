#!/usr/bin/env bash
# Run chezmoi with 1Password service-account auth loaded from macOS Keychain.

set -euo pipefail

readonly KEYCHAIN_SERVICE="${CHEZMOI_OP_SERVICE_ACCOUNT_TOKEN_KEYCHAIN_SERVICE:-chezmoi-op-service-account-token}"
readonly KEYCHAIN_ACCOUNT="${CHEZMOI_OP_SERVICE_ACCOUNT_TOKEN_KEYCHAIN_ACCOUNT:-${USER:-chezmoi}}"
readonly SERVICE_CONFIG="${CHEZMOI_SERVICE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi-service.toml}"

token="${OP_SERVICE_ACCOUNT_TOKEN:-}"
if [[ -z "$token" ]]; then
  if command -v security >/dev/null 2>&1; then
    token=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)
  fi
fi

if [[ -z "$token" ]]; then
  cat >&2 <<EOF
Missing 1Password service account token in macOS Keychain.

Seed it once after unlocking 1Password:
  token=\$(op read --no-newline 'op://Keys/1Password Service Account - Chezmoi/credential')
  security add-generic-password -a "\$USER" -s "$KEYCHAIN_SERVICE" -w "\$token" -U
  unset token
EOF
  exit 1
fi

if [[ ! -r "$SERVICE_CONFIG" ]]; then
  echo "Missing chezmoi service config: $SERVICE_CONFIG" >&2
  exit 1
fi

OP_SERVICE_ACCOUNT_TOKEN="$token" exec chezmoi --config "$SERVICE_CONFIG" "$@"
