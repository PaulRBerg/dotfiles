#!/usr/bin/env bash
# Merge selected dotfiles-managed iTerm2 settings into the normal macOS defaults domain.
# managed.plist hash: {{ include "dot_config/iterm2/managed.plist" | sha256sum }}
# shellcheck disable=SC2034
set -euo pipefail

readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# run_onchange_ scripts execute from a temp dir, so source from the installed path
source "$HOME/.setup/lib/common.sh"

readonly MANAGED_PLIST='{{ joinPath .chezmoi.sourceDir "dot_config/iterm2/managed.plist" }}'
readonly MERGE_SCRIPT='{{ joinPath .chezmoi.sourceDir "dot_setup/executable_merge_iterm2_prefs.py" }}'

if [[ ! -f "$MANAGED_PLIST" ]]; then
  log_error "Managed iTerm2 plist not found: ${MANAGED_PLIST}"
  exit 1
fi

if [[ ! -f "$MERGE_SCRIPT" ]]; then
  log_error "iTerm2 merge helper not found: ${MERGE_SCRIPT}"
  exit 1
fi

python_cmd=()
if command -v uv >/dev/null 2>&1; then
  python_cmd=(uv run --quiet python)
elif command -v python3 >/dev/null 2>&1; then
  python_cmd=(python3)
else
  log_error "python3 or uv is required to merge iTerm2 preferences"
  exit 1
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

current_plist="${tmp_dir}/current.plist"
merged_plist="${tmp_dir}/merged.plist"

if ! defaults export com.googlecode.iterm2 "$current_plist" >/dev/null 2>&1; then
  plutil -create xml1 "$current_plist"
fi

"${python_cmd[@]}" "$MERGE_SCRIPT" "$MANAGED_PLIST" "$current_plist" "$merged_plist"
defaults import com.googlecode.iterm2 "$merged_plist"

defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool false
defaults delete com.googlecode.iterm2 PrefsCustomFolder >/dev/null 2>&1 || true
defaults delete com.googlecode.iterm2 NoSyncNeverRemindPrefsChangesLostForFile >/dev/null 2>&1 || true
defaults delete com.googlecode.iterm2 NoSyncNeverRemindPrefsChangesLostForFile_selection >/dev/null 2>&1 || true

log_success "Merged managed iTerm2 settings into the normal macOS preferences domain"
