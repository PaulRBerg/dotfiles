#!/usr/bin/env bash
# Reload the CleanShot screenshot renamer after chezmoi installs or changes its files.
# worker hash: {{ include "dot_config/prb/bin/executable_cleanshot_screenshot_renamer_macos.sh" | sha256sum }}
# clipboard helper hash: {{ include "dot_config/prb/bin/executable_cleanshot_clipboard_macos.sh" | sha256sum }}
# plist hash: {{ include "Library/LaunchAgents/local.cleanshot-screenshot-renamer.plist.tmpl" | sha256sum }}

set -euo pipefail

readonly label="local.cleanshot-screenshot-renamer"
domain="gui/$(id -u)"
readonly domain
readonly plist="$HOME/Library/LaunchAgents/$label.plist"
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cleanshot-screenshot-renamer"
readonly enabled_at="$state_dir/enabled-at"

if [[ ! -f "$plist" ]]; then
  echo "CleanShot screenshot renamer plist not found: $plist" >&2
  exit 1
fi

umask 077
mkdir -p "$state_dir"
chmod 700 "$state_dir"
if [[ ! -f "$enabled_at" ]]; then
  marker_tmp="$(mktemp "$state_dir/.enabled-at.XXXXXX")"
  date '+%s' >"$marker_tmp"
  chmod 600 "$marker_tmp"
  mv "$marker_tmp" "$enabled_at"
fi

if ! launchctl print "$domain" >/dev/null 2>&1; then
  echo "GUI launchd domain unavailable; CleanShot screenshot renamer will load at the next login" >&2
  exit 0
fi

launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
launchctl bootstrap "$domain" "$plist"
launchctl print "$domain/$label" >/dev/null

echo "Loaded $label" >&2
