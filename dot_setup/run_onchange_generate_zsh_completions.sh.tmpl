#!/usr/bin/env bash
# hash: {{ .chezmoi.os }}
# Generates zsh completion files for CLI tools

set -euo pipefail

ZFUNC_DIR="$HOME/.zfunc"
mkdir -p "$ZFUNC_DIR"

# generate <command> <completion-name> <generator...>: write _<completion-name>
# from the generator's stdout when <command> is installed.
generate() {
  local command_name="$1"
  local completion_name="$2"
  shift
  shift

  if command -v "$command_name" >/dev/null 2>&1; then
    local completion_path tmp
    completion_path="$ZFUNC_DIR/_$completion_name"
    tmp=$(mktemp "${completion_path}.XXXXXX")

    if "$@" >"$tmp"; then
      mv "$tmp" "$completion_path"
      echo "  ✓ $completion_name" >&2
    else
      rm -f "$tmp"
      echo "  ⚠ $completion_name (generation failed)" >&2
    fi
  else
    echo "  ⊘ $command_name (not installed)" >&2
  fi
}

echo "🔧 Generating zsh completions..." >&2
echo "" >&2

generate chezmoi chezmoi chezmoi completion zsh
generate codex codex codex completion zsh
generate gh gh gh completion -s zsh
generate just just just --completions zsh
generate uv uv uv generate-shell-completion zsh
generate starship starship starship completions zsh
generate atuin atuin atuin gen-completions --shell zsh
generate zellij zellij zellij setup --generate-completion zsh
generate op op op completion zsh
generate docker docker docker completion zsh
generate kubectl kubectl kubectl completion zsh
generate ast-grep ast-grep ast-grep completions zsh
generate sg sg sg completions zsh
generate omp omp omp completions zsh

generate anchor anchor anchor completions zsh
generate avm avm avm completions zsh
generate cast cast cast completions zsh
generate forge forge forge completions zsh
generate nr nr nr --completion-zsh
generate sentry-cli sentry-cli sentry-cli completions zsh
generate solana solana solana completion -s zsh

# OpenClaw is no longer managed; remove the completion generated by earlier applies.
rm -f "$ZFUNC_DIR/_openclaw"

echo "" >&2
echo "✓ Completions generated in $ZFUNC_DIR" >&2
