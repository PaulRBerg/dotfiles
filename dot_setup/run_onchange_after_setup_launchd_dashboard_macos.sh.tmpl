#!/usr/bin/env bash
# Reload the launchd dashboard after chezmoi installs or changes its plist or server (index.html is read per request).
# plist hash: {{ include "Library/LaunchAgents/local.launchd-dashboard.plist.tmpl" | sha256sum }}
# server hash: {{ include "dot_config/launchd-dashboard/server.ts" | sha256sum }}

set -euo pipefail

readonly label="local.launchd-dashboard"
readonly domain="gui/$(id -u)"
readonly plist="$HOME/Library/LaunchAgents/$label.plist"

if [[ ! -f "$plist" ]]; then
  echo "launchd dashboard plist not found: $plist" >&2
  exit 1
fi

plutil -lint "$plist"

if ! launchctl print "$domain" >/dev/null 2>&1; then
  echo "GUI launchd domain unavailable; launchd dashboard will load at the next login" >&2
  exit 0
fi

launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
for attempt in 1 2; do
  if launchctl bootstrap "$domain" "$plist"; then
    break
  fi

  if [[ "$attempt" -eq 2 ]]; then
    echo "Failed to bootstrap $label after $attempt attempts" >&2
    exit 1
  fi

  sleep 1
done
launchctl print "$domain/$label" >/dev/null

echo "Loaded $label" >&2
