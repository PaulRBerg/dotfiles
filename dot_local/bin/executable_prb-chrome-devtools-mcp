#!/bin/zsh
set -eu

port="${PRB_AGENT_CHROME_PORT:-9222}"
profile_dir="${PRB_AGENT_CHROME_PROFILE:-$HOME/Library/Application Support/prb-agent-chrome}"
chrome_bin="${PRB_AGENT_CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/prb-agent-chrome"
log_file="$state_dir/chrome.log"

mkdir -p "$profile_dir" "$state_dir"

if ! curl -fsS "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
  "$chrome_bin" \
    "--remote-debugging-port=$port" \
    "--user-data-dir=$profile_dir" \
    "--no-first-run" \
    "--no-default-browser-check" \
    about:blank \
    >"$log_file" 2>&1 &

  attempts=0
  while ! curl -fsS "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 100 ]; then
      echo "Chrome did not expose CDP on 127.0.0.1:$port. See $log_file" >&2
      exit 1
    fi
    sleep 0.1
  done
fi

exec bunx -y chrome-devtools-mcp@latest \
  "--browser-url=http://127.0.0.1:$port" \
  --experimental-page-id-routing \
  --experimental-memory \
  --experimental-vision \
  --experimental-structured-content \
  --experimental-screencast \
  --experimental-ffmpeg-path=/opt/homebrew/bin/ffmpeg \
  --redact-network-headers \
  --no-performance-crux \
  --no-usage-statistics
